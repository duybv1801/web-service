        {
          "name": "Login super-admin (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Trả về Bearer token\", () => {",
                  "    pm.expect(json.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(json.accessToken).to.be.a(\"string\");",
                  "    pm.expect(json.expiresIn).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Cache-Control: no-store\", () => pm.response.to.have.header(\"Cache-Control\", \"no-store\"));",
                  "// Lưu token cho các request sau (ưu tiên environment đang chọn)",
                  "if (json.accessToken) {",
                  "    if (pm.environment.name) pm.environment.set(\"admin_token\", json.accessToken);",
                  "    else pm.collectionVariables.set(\"admin_token\", json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"grantType\": \"password\",\n    \"email\": \"duy.bv251054m@sis.hust.edu.vn\",\n    \"password\": \"Admin@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/tokens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "tokens"
              ]
            }
          }
        },
