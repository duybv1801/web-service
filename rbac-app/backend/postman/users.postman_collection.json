  "info": {
    "name": "RBAC - API",
    "description": "Test các endpoint trong routes/auth.js và routes/users.js.\n\nCần environment có biến `base_url` (vd: http://localhost:3001) và `token` (access token Bearer).\n\nBiến collection `userId`, `roleId` được tự động gán sau request \"Create user\". Chạy theo thứ tự trong folder để test toàn luồng.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
