      "name": "Create user",
      "item": [
        {
          "name": "Create user (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newEmail', `test.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Có header Location', () => pm.response.to.have.header('Location'));",
                  "const json = pm.response.json();",
                  "pm.test('Không trả passwordHash', () => pm.expect(json).to.not.have.property('passwordHash'));",
                  "pm.test('Mặc định role member', () => pm.expect(json.roles.map(r => r.code)).to.include('member'));",
                  "pm.collectionVariables.set('userId', json.id);",
                  "if (json.roles.length) pm.collectionVariables.set('roleId', json.roles[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{newEmail}}\",\n    \"fullName\": \"Nguyễn Văn Test\",\n    \"phone\": \"+84912345678\",\n    \"password\": \"Test@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
