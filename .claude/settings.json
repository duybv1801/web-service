{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Bash(cat *.env)",
      "Bash(less *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(source *.env)"
    ]
  }
}
